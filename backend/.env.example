# 应用配置
APP_NAME=Health Assistant
APP_VERSION=0.3.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# 数据库
DATABASE_URL=postgresql+asyncpg://health_user:your_password@localhost:5432/health_db
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# 固定单用户的数据主体；生产环境必须配置
PRIMARY_USER_ID=00000000-0000-0000-0000-000000000000
# 旧部署兼容项，新部署请留空并只使用 PRIMARY_USER_ID
DEFAULT_USER_ID=
REQUIRE_WEB_ACCESS_PASSWORD=true
WEB_ACCESS_PASSWORD=replace-with-a-strong-private-password

# Polar配置 (训练数据)
POLAR_CLIENT_ID=your_polar_client_id
POLAR_CLIENT_SECRET=your_polar_client_secret
POLAR_REDIRECT_URI=https://your-domain.com/api/v1/polar/callback
POLAR_BASE_URL=https://www.polaraccesslink.com/v3

# Oura配置 (睡眠/恢复数据)
OURA_CLIENT_ID=your_oura_client_id
OURA_CLIENT_SECRET=your_oura_client_secret
OURA_REDIRECT_URI=https://your-domain.com/api/v1/oura/callback

# AI 配置：统一通过已登录的 Codex CLI，不需要在应用中保存模型 API Key
AI_PROVIDER=codex
CODEX_CLI_PATH=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=medium
CODEX_VISION_REASONING_EFFORT=medium
CODEX_TEXT_REASONING_EFFORT=low
CODEX_IMAGE_AGENT_REASONING_EFFORT=low
CODEX_IMAGE_MODEL=gpt-image-2
CODEX_MAX_CONCURRENCY=2
POSTER_IMAGE_SIZE=1K
MEDIA_URL_TTL_SECONDS=3600
CODEX_REQUEST_TIMEOUT_SECONDS=130
NUTRITION_CORE_TIMEOUT_SECONDS=60
NUTRITION_CORE_TOTAL_TIMEOUT_SECONDS=130
NUTRITION_RECOMMENDATION_TIMEOUT_SECONDS=180
POSTER_REQUEST_TIMEOUT_SECONDS=110
POSTER_DAILY_LIMIT=5

# 微信小程序
WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_secret

# 训练目标配置
TARGET_ZONE2_MIN=55
TARGET_ZONE2_MIN_RANGE=45
TARGET_ZONE2_MAX_RANGE=60
TARGET_HI_MIN=2
TARGET_HI_MIN_RANGE=1
TARGET_HI_MAX_RANGE=5
TARGET_WEEKLY_ZONE2_MIN=200
TARGET_WEEKLY_ZONE2_MAX=300
TARGET_WEEKLY_HI_MAX=30

# 服务器时区（香港时间）
TZ=Asia/Hong_Kong

# 代理配置（腾讯云服务器需要）
NO_PROXY=localhost,127.0.0.1,::1,169.254.0.0/16,.tencentyun.com,*.tencentyun.com

# CORS配置
ALLOWED_ORIGINS=["https://servicewechat.com","https://your-domain.com"]

# 日志配置
LOG_LEVEL=INFO

# MCP API配置 (Claude Code 集成)
MCP_API_KEY=your_mcp_api_key
