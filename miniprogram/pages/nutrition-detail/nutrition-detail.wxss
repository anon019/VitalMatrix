/* pages/nutrition-detail/nutrition-detail.wxss */
/* 设计概念：自然餐桌 Natural Table - 详情页 */
/* 与饮食记录页保持一致的设计语言 */

/* ========== CSS变量定义 ========== */
.page-container {
  /* 主色调 - 自然暖色系 */
  --color-bg-primary: #FAF7F2;
  --color-bg-secondary: #F5F0E8;
  --color-bg-card: #FFFFFF;

  /* 强调色 */
  --color-accent-green: #2D5A27;
  --color-accent-green-light: #4A7C43;
  --color-accent-amber: #D97706;
  --color-accent-amber-light: #F59E0B;

  /* 营养色彩 */
  --color-calories: #E85D04;
  --color-protein: #9D4EDD;
  --color-carbs: #E9C46A;
  --color-fat: #52B788;

  /* 主题色 */
  --color-green: #22C55E;
  --color-blue: #3B82F6;
  --color-purple: #8B5CF6;
  --color-amber: #F59E0B;
  --color-teal: #14B8A6;
  --color-red: #EF4444;

  /* 文字色彩 */
  --color-text-primary: #2C2417;
  --color-text-secondary: #6B5E4C;
  --color-text-muted: #9C8E7C;
  --color-text-light: #B8A898;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(44, 36, 23, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(44, 36, 23, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(44, 36, 23, 0.12);

  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 40rpx;
  --radius-full: 200rpx;

  background-color: var(--color-bg-primary);
}

/* ========== 页面容器 ========== */
.page-container {
  min-height: 100vh;
  position: relative;
}

/* ========== 装饰背景 ========== */
.bg-decoration {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 100vh;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.3;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(45, 90, 39, 0.12) 0%, transparent 70%);
  top: 30%;
  right: -100rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(217, 119, 6, 0.1) 0%, transparent 70%);
  bottom: 20%;
  left: -80rpx;
}

/* ========== 加载状态 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 40rpx;
}

.loading-bowl {
  position: relative;
  width: 120rpx;
  height: 80rpx;
}

.bowl-body {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 60rpx;
  background: linear-gradient(180deg, #E8DFD3 0%, #D4C8B8 100%);
  border-radius: 0 0 50rpx 50rpx;
  box-shadow: inset 0 -6rpx 12rpx rgba(0,0,0,0.1);
}

.steam {
  position: absolute;
  bottom: 50rpx;
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(150, 140, 130, 0.4) 100%);
  border-radius: 4rpx;
  animation: steam-rise 1.5s ease-in-out infinite;
}

.steam-1 { left: 30rpx; animation-delay: 0s; }
.steam-2 { left: 55rpx; animation-delay: 0.3s; }
.steam-3 { left: 80rpx; animation-delay: 0.6s; }

@keyframes steam-rise {
  0% { opacity: 0; transform: translateY(0) scaleY(1); }
  50% { opacity: 0.6; }
  100% { opacity: 0; transform: translateY(-40rpx) scaleY(1.5); }
}

.loading-text {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: var(--color-text-muted);
  letter-spacing: 2rpx;
}

/* ========== 内容区域 ========== */
.content {
  position: relative;
  z-index: 1;
}

/* ========== 照片英雄区 ========== */
.photo-hero {
  position: relative;
  width: 100%;
  height: 480rpx;
  background: #1a1a1a;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.no-image {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2C2417 0%, #1a1a1a 100%);
}

.no-image-icon {
  font-size: 64rpx;
  opacity: 0.5;
  margin-bottom: 16rpx;
}

.no-image-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 100%);
  display: flex;
  align-items: flex-end;
  padding: 32rpx;
}

.hero-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.meal-type-pill {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.meal-datetime {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ========== 主内容区域 ========== */
.main-content {
  padding: 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

/* ========== 入场动画 ========== */
.anim-slide-up {
  animation: slideUp 0.5s ease-out forwards;
  opacity: 0;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ========== 通用卡片样式 ========== */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-md);
}

.card-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 12rpx;
}

.card-icon {
  font-size: 32rpx;
  line-height: 1;
  transform: translateY(-2rpx);
}

.card-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.card-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

.card-body {
  padding: 24rpx;
}

/* 卡片头部主题色 */
.green-theme {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
}

.amber-theme {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
}

.blue-theme {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
}

.purple-theme {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
}

.teal-theme {
  background: linear-gradient(135deg, #14B8A6 0%, #0D9488 100%);
}

.gray-theme {
  background: linear-gradient(135deg, #6B7280 0%, #4B5563 100%);
}

/* ========== 营养概览卡片 ========== */
.nutrition-showcase {
  text-align: center;
}

.calorie-display {
  margin-bottom: 24rpx;
}

.calorie-number {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--color-calories);
  line-height: 1;
}

.calorie-unit {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

.macro-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.macro-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-lg);
  min-width: 140rpx;
}

.macro-chip.protein {
  background: linear-gradient(135deg, rgba(157, 78, 221, 0.12) 0%, rgba(157, 78, 221, 0.06) 100%);
}

.macro-chip.carbs {
  background: linear-gradient(135deg, rgba(233, 196, 106, 0.15) 0%, rgba(233, 196, 106, 0.08) 100%);
}

.macro-chip.fat {
  background: linear-gradient(135deg, rgba(82, 183, 136, 0.12) 0%, rgba(82, 183, 136, 0.06) 100%);
}

.chip-label {
  font-size: 20rpx;
  color: var(--color-text-muted);
  margin-bottom: 6rpx;
}

.chip-value {
  font-size: 28rpx;
  font-weight: 700;
}

.macro-chip.protein .chip-value { color: var(--color-protein); }
.macro-chip.carbs .chip-value { color: #C59545; }
.macro-chip.fat .chip-value { color: var(--color-fat); }

.fiber-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 12rpx 20rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-md);
}

.fiber-icon {
  font-size: 24rpx;
  line-height: 1;
  transform: translateY(-1rpx);
}

.fiber-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ========== 综合评价卡片 ========== */
.rating-pill {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
}

.rating-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx;
}

.score-display {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.score-number {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1;
}

.score-suffix {
  font-size: 32rpx;
  color: var(--color-text-muted);
}

.ai-model-tag {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--color-text-light);
  background: var(--color-bg-secondary);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
}

/* ========== 识别的食物卡片 ========== */
.foods-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.food-item {
  padding: 20rpx;
  background: linear-gradient(135deg, #F0FDF4 0%, #ECFDF5 100%);
  border-radius: var(--radius-lg);
  border-left: 6rpx solid var(--color-green);
}

.food-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.food-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.food-weight-tag {
  font-size: 20rpx;
  color: var(--color-text-muted);
  background: rgba(0, 0, 0, 0.05);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

.food-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.food-calories {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.cal-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-calories);
}

.cal-unit {
  font-size: 18rpx;
  color: var(--color-text-muted);
}

.food-macros {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.food-macros .macro-item {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.food-macros .macro-sep {
  font-size: 18rpx;
  color: var(--color-text-light);
}

.food-notes {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 12rpx;
  background: #FFF7ED;
  border-radius: var(--radius-md);
}

.food-notes .notes-icon {
  font-size: 20rpx;
  flex-shrink: 0;
  line-height: 1;
  transform: translateY(-1rpx);
}

.food-notes .notes-text {
  font-size: 22rpx;
  color: #EA580C;
  line-height: 1.6;
}

/* ========== 营养分析卡片 ========== */
.analysis-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.analysis-item {
  padding: 20rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-lg);
}

.analysis-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.analysis-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.label-emoji {
  font-size: 28rpx;
  line-height: 1;
  transform: translateY(-1rpx);
}

.label-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.analysis-rating {
  font-size: 24rpx;
  font-weight: 600;
}

.analysis-rating.rating-good { color: #22C55E; }
.analysis-rating.rating-warning { color: #F59E0B; }
.analysis-rating.rating-danger { color: #EF4444; }
.analysis-rating.rating-info { color: #3B82F6; }

.analysis-comment {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.sodium-alert {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-radius: var(--radius-lg);
  border-left: 6rpx solid #F59E0B;
}

.alert-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  line-height: 1;
  transform: translateY(-1rpx);
}

.alert-text {
  font-size: 24rpx;
  color: #92400E;
  line-height: 1.6;
  font-weight: 500;
}

/* ========== 健康洞察卡片 ========== */
.insight-group {
  margin-bottom: 20rpx;
}

.insight-group:last-child {
  margin-bottom: 0;
}

.group-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.group-icon {
  font-size: 24rpx;
  line-height: 1;
  transform: translateY(-1rpx);
}

.group-title {
  font-size: 24rpx;
  font-weight: 600;
}

.group-header.good .group-title { color: #22C55E; }
.group-header.warn .group-title { color: #F59E0B; }
.group-header.risk .group-title { color: #EF4444; }

.insight-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.insight-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border-left: 4rpx solid;
}

.insight-item.good { border-left-color: #22C55E; }
.insight-item.warn { border-left-color: #F59E0B; }
.insight-item.risk { border-left-color: #EF4444; }

.insight-bullet {
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.insight-item.good .insight-bullet { color: #22C55E; }
.insight-item.warn .insight-bullet { color: #F59E0B; }
.insight-item.risk .insight-bullet { color: #EF4444; }

.insight-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ========== 饮食建议卡片 ========== */
.summary-box {
  padding: 20rpx;
  background: linear-gradient(135deg, #F0FDF4 0%, #ECFDF5 100%);
  border-radius: var(--radius-lg);
  border-left: 6rpx solid #22C55E;
  margin-bottom: 20rpx;
}

.summary-text {
  font-size: 26rpx;
  color: #166534;
  line-height: 1.7;
  font-weight: 500;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}

.section-label .label-icon {
  font-size: 24rpx;
  line-height: 1;
  transform: translateY(-1rpx);
}

.section-label .label-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-item {
  padding: 16rpx 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  border-left: 4rpx solid #22C55E;
  box-shadow: var(--shadow-sm);
}

.action-item.priority-high { border-left-color: #EF4444; }
.action-item.priority-medium { border-left-color: #F59E0B; }
.action-item.priority-low { border-left-color: #22C55E; }

.action-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.action-number {
  width: 36rpx;
  height: 36rpx;
  background: #22C55E;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.action-item.priority-high .action-number { background: #EF4444; }
.action-item.priority-medium .action-number { background: #F59E0B; }

.action-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.action-rationale {
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
  padding-left: 48rpx;
}

.hydration-box {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
  border-radius: var(--radius-lg);
  border-left: 6rpx solid #3B82F6;
}

.hydration-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  line-height: 1;
  transform: translateY(-1rpx);
}

.hydration-text {
  font-size: 24rpx;
  color: #1E40AF;
  line-height: 1.6;
  font-weight: 500;
}

/* ========== 下一餐推荐 ========== */
.next-meals-section {
  margin-top: 20rpx;
}

.next-meal-card {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #F0F9FF 0%, #F0FDF4 100%);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1rpx solid #E0F2FE;
}

.meal-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #10B981 100%);
}

.meal-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.meal-calories-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

.dishes-list {
  padding: 16rpx 20rpx;
}

.dish-card {
  padding: 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
}

.dish-card:last-child {
  margin-bottom: 0;
}

.dish-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.dish-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
}

.dish-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dish-time {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.dish-cal {
  font-size: 22rpx;
  color: #22C55E;
  font-weight: 500;
}

.dish-detail {
  margin-bottom: 12rpx;
}

.detail-row {
  display: flex;
  margin-bottom: 6rpx;
  line-height: 1.5;
}

.detail-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  width: 60rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  flex: 1;
}

.dish-benefit {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 10rpx 12rpx;
  background: #F0FDF4;
  border-radius: var(--radius-sm);
}

.benefit-icon {
  font-size: 20rpx;
  flex-shrink: 0;
  line-height: 1;
  transform: translateY(-1rpx);
}

.benefit-text {
  font-size: 22rpx;
  color: #059669;
  line-height: 1.5;
}

.meal-reason {
  padding: 12rpx 20rpx 16rpx;
  border-top: 1rpx dashed #E5E7EB;
}

.reason-text {
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
  font-style: italic;
}

/* 主食推荐 */
.staple-suggestion {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-top: 1rpx dashed #E5E7EB;
}

.staple-icon {
  font-size: 24rpx;
}

.staple-label {
  font-size: 22rpx;
  color: #92400E;
  font-weight: 500;
}

.staple-text {
  font-size: 22rpx;
  color: #78350F;
  margin-left: 8rpx;
}

/* 下一餐简单建议 (next_meal_tips) */
.next-meal-tips {
  margin-top: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #F0FDF4 0%, #ECFDF5 100%);
  border-radius: var(--radius-lg);
  border-left: 6rpx solid #22C55E;
}

.tip-header {
  margin-bottom: 8rpx;
}

.tip-meal {
  font-size: 26rpx;
  font-weight: 600;
  color: #166534;
}

.tip-suggestion {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.tip-benefit {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 10rpx 12rpx;
  background: rgba(34, 197, 94, 0.1);
  border-radius: var(--radius-sm);
  margin-top: 8rpx;
}

/* 旧版下一餐菜单兼容 */
.next-meal-menu {
  margin-top: 20rpx;
}

.menu-content {
  padding: 20rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #F3E5F5 100%);
  border-radius: var(--radius-lg);
  border-left: 6rpx solid #3B82F6;
}

.menu-text {
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ========== 备注卡片 ========== */
.notes-content {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

/* ========== 操作按钮 ========== */
.action-buttons {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0 40rpx;
}

.btn-primary {
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-xl);
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 24rpx rgba(59, 130, 246, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-danger {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--color-bg-card);
  color: #EF4444;
  border: 2rpx solid #FECACA;
  border-radius: var(--radius-xl);
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-danger::after {
  border: none;
}

.btn-danger:active {
  background: #FEF2F2;
  border-color: #EF4444;
}

.btn-icon {
  font-size: 28rpx;
}

.btn-text {
  font-size: 28rpx;
}

/* ========== 弹窗通用样式 ========== */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(44, 36, 23, 0.7);
  backdrop-filter: blur(8px);
}

.modal-box {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-lg);
  animation: modalPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalPop {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.modal-spinner {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
}

.spinner-ring {
  position: absolute;
  inset: 0;
  border: 4rpx solid transparent;
  border-top-color: var(--color-accent-green);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.spinner-icon {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ========== 海报预览 ========== */
.poster-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.9);
}

.poster-container {
  width: 90%;
  max-width: 600px;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.poster-image {
  width: 100%;
  border-radius: var(--radius-lg);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.poster-buttons {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.poster-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.poster-btn::after {
  border: none;
}

.poster-btn.save {
  background: linear-gradient(135deg, #8B5CF6 0%, #6366F1 100%);
  color: #FFFFFF;
}

.poster-btn.close {
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
}

.poster-btn:active {
  opacity: 0.8;
}

/* ========== 隐藏的Canvas ========== */
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
}

/* 后端 V2 适配：沿用 Natural Table 色彩与材质 */
.load-error-copy {
  max-width: 560rpx;
  margin: 16rpx auto 28rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.retry-load {
  width: 260rpx;
}

.portion-assumption {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #DCE8E2;
  border-radius: 16rpx;
  background: #F7FAF8;
}

.portion-assumption-label {
  color: #27624F;
  font-size: 22rpx;
  font-weight: 700;
}

.portion-assumption-text {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.recommend-title-wrap,
.recommend-status-copy,
.meal-title-stack,
.meal-experience {
  display: flex;
  flex-direction: column;
}

.recommend-title-wrap {
  gap: 2rpx;
}

.recommend-kicker {
  color: var(--color-text-muted);
  font-size: 20rpx;
}

.recommend-status {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 20rpx;
  border: 1rpx solid #DCE8E2;
  border-radius: 18rpx;
  background: #F0F6F3;
}

.recommend-status.is-error {
  border-color: #F1C7C3;
  background: #FFF5F4;
}

.recommend-status.is-waiting {
  align-items: flex-start;
  flex-direction: column;
  border-color: #E9D8B8;
  background: #FFF9EE;
}

.recommend-status-copy {
  flex: 1;
  gap: 6rpx;
}

.recommend-status-title {
  color: var(--color-text-primary);
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.45;
}

.recommend-status-hint {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.recommend-status-spinner {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #CFE1D9;
  border-top-color: #27624F;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.recommend-retry-btn,
.recommend-regenerate-btn {
  flex: none;
  margin: 0;
  border: 0;
  border-radius: 12rpx;
  background: #27624F;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1.4;
}

.recommend-retry-btn {
  padding: 12rpx 18rpx;
}

.recommend-regenerate-btn {
  width: 100%;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: #EEF4F1;
  color: #27624F;
}

.recommend-retry-btn::after,
.recommend-regenerate-btn::after {
  border: 0;
}

.recommend-empty {
  padding: 24rpx;
  color: var(--color-text-secondary);
  background: #F7FAF8;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.meal-title-stack {
  gap: 4rpx;
}

.meal-timing {
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
}

.meal-experience {
  gap: 8rpx;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #E2E9E6;
  background: #F7FAF8;
}

.meal-flavor {
  color: #27624F;
  font-size: 23rpx;
  font-weight: 650;
}

.meal-experience-note {
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.insight-toggle {
  min-width: 92rpx;
  margin-left: auto;
  padding: 8rpx 18rpx;
  color: #27766B;
  background: rgba(39, 118, 107, 0.1);
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.insight-toggle::after,
.poster-error-retry::after,
.poster-header-close::after {
  border: none;
}

.uncertainty-group .group-header {
  color: #6B7280;
}

.poster-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  color: #B45309;
  background: #FFF8E8;
  border: 1rpx solid #F2DFC2;
  border-radius: var(--radius-md);
  font-size: 24rpx;
}

.poster-prerequisite {
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx 18rpx;
  color: #8A6B35;
  background: #FFF8E8;
  border: 1rpx solid #EEDDBE;
  border-radius: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.poster-error-retry {
  flex: none;
  margin: 0;
  padding: 8rpx 18rpx;
  color: #FFFFFF;
  background: #8B7355;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.poster-container {
  width: 92%;
  height: 92vh;
  max-height: 92vh;
  align-items: stretch;
  gap: 18rpx;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
  background: #F7F2E8;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.poster-preview-header {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.poster-preview-title,
.poster-preview-meta {
  display: block;
}

.poster-preview-title {
  color: #2C2417;
  font-size: 30rpx;
  font-weight: 700;
}

.poster-preview-meta {
  margin-top: 4rpx;
  color: #8B7355;
  font-size: 20rpx;
}

.poster-header-close {
  flex: none;
  margin: 0;
  padding: 10rpx 20rpx;
  color: #6B5E4C;
  background: rgba(139, 115, 85, 0.1);
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 1.4;
}

.poster-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  background: #FFFFFF;
  border-radius: var(--radius-md);
}

.poster-image-loading {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  color: #7A6D5B;
  background: #F2EDE4;
  font-size: 23rpx;
}

.poster-image-loading-shimmer {
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(100deg, transparent 20%, rgba(255, 255, 255, 0.62) 48%, transparent 76%);
  animation: poster-shimmer 1.5s ease-in-out infinite;
}

.poster-image-loading text {
  position: relative;
  z-index: 1;
}

.poster-image-error {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 3 / 4;
  box-sizing: border-box;
  padding: 32rpx;
  color: #9A4F47;
  background: #FFF4F2;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

@keyframes poster-shimmer {
  100% {
    transform: translateX(100%);
  }
}

.poster-image {
  display: block;
  width: 100%;
  border-radius: 0;
  box-shadow: none;
}

.poster-buttons {
  flex: none;
  gap: 12rpx;
}

.poster-safe-area {
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
}

.poster-btn {
  min-width: 0;
  padding: 20rpx 10rpx;
  font-size: 23rpx;
}

.poster-btn.save {
  color: #FFFFFF;
  background: linear-gradient(135deg, #52B788 0%, #40916C 100%);
}

.poster-btn.share {
  color: #FFFFFF;
  background: linear-gradient(135deg, #8B7355 0%, #6B5E4C 100%);
}

.poster-btn.regenerate {
  color: #6B5E4C;
  background: #FFFFFF;
  border: 1rpx solid #D8CDBE;
}

.analysis-summary-strip {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #F7FAF8;
  border: 1rpx solid rgba(46, 125, 50, 0.14);
}

.analysis-summary-copy {
  flex: 1;
  min-width: 0;
}

.analysis-summary-label,
.analysis-summary-text {
  display: block;
}

.analysis-summary-label {
  margin-bottom: 8rpx;
  color: #2E7D32;
  font-size: 22rpx;
  font-weight: 700;
}

.analysis-summary-text {
  color: #37474F;
  font-size: 26rpx;
  line-height: 1.6;
}

.confidence-badge,
.model-status,
.reanalyze-btn {
  border-radius: 999rpx;
  font-size: 22rpx;
}

.confidence-badge {
  flex: none;
  padding: 8rpx 14rpx;
  background: #EEF2F6;
  color: #607D8B;
}

.confidence-high { background: #E8F5E9; color: #2E7D32; }
.confidence-medium { background: #FFF3E0; color: #B26A00; }
.confidence-low { background: #FFEBEE; color: #C62828; }

.model-status-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.model-status {
  padding: 8rpx 14rpx;
  background: #EDF5EE;
  color: #2E7D32;
}

.model-status.legacy {
  background: #FFF3E0;
  color: #B26A00;
}

.model-status.current {
  background: #E3F2FD;
  color: #1565C0;
}

.reanalyze-btn {
  min-height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  line-height: 72rpx;
  color: #FFFFFF;
  background: #2E7D32;
}

.reanalyze-btn::after {
  border: none;
}

.poster-wait-hide {
  min-height: 72rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  color: #6B5E4C;
  background: rgba(139, 115, 85, 0.1);
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 72rpx;
}

.poster-wait-hide::after {
  border: none;
}

/* 新版饮食分析：用户只看到结论与可执行内容，不暴露模型实现细节 */
.meal-brief {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  background: #F5F8F3;
  border: 1rpx solid rgba(55, 94, 60, 0.14);
  border-radius: 22rpx;
}

.meal-brief-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.meal-brief-label {
  color: #315D3A;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.meal-brief-text,
.meal-brief-hint {
  display: block;
}

.meal-brief-text {
  display: -webkit-box;
  overflow: hidden;
  color: #33403A;
  font-size: 25rpx;
  line-height: 1.65;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.meal-brief-hint {
  margin-top: 10rpx;
  color: #7A877F;
  font-size: 20rpx;
}

/* 后续餐单：三餐切换，避免一次堆叠三组长食谱 */
.meal-plan-heading {
  margin-bottom: 18rpx;
}

.meal-plan-title,
.meal-plan-subtitle {
  display: block;
}

.meal-plan-title {
  color: #26372C;
  font-size: 27rpx;
  font-weight: 700;
}

.meal-plan-subtitle {
  margin-top: 6rpx;
  color: #7A877F;
  font-size: 21rpx;
  line-height: 1.5;
}

.meal-plan-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  padding: 8rpx;
  background: #F1F3EF;
  border-radius: 20rpx;
}

.meal-plan-tab {
  min-width: 0;
  padding: 16rpx 8rpx 14rpx;
  text-align: center;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
}

.meal-plan-tab.active {
  background: #FFFFFF;
  border-color: rgba(55, 94, 60, 0.14);
  box-shadow: 0 6rpx 16rpx rgba(38, 55, 44, 0.08);
}

.meal-plan-tab-pressed {
  transform: scale(0.97);
}

.meal-plan-tab-icon,
.meal-plan-tab-name,
.meal-plan-tab-cal {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meal-plan-tab-icon {
  margin-bottom: 5rpx;
  font-size: 27rpx;
  line-height: 1;
}

.meal-plan-tab-name {
  color: #647168;
  font-size: 23rpx;
  font-weight: 600;
}

.meal-plan-tab.active .meal-plan-tab-name {
  color: #315D3A;
}

.meal-plan-tab-cal {
  margin-top: 5rpx;
  color: #96A098;
  font-size: 18rpx;
}

.next-meal-card {
  margin-top: 14rpx;
  background: #F8FAF7;
  border-color: rgba(55, 94, 60, 0.13);
}

.meal-card-header {
  align-items: stretch;
  padding: 20rpx 22rpx;
  background: #315D3A;
}

.meal-title-stack {
  min-width: 0;
}

.meal-header-eyebrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.meal-kicker {
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
  font-weight: 650;
}

.meal-title {
  display: block;
  margin-top: 8rpx;
  line-height: 1.4;
  word-break: break-word;
}

.meal-timing {
  display: block;
  margin-top: 6rpx;
}

.dish-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: -2rpx 0 12rpx;
}

.dish-fact {
  padding: 6rpx 10rpx;
  color: #52645A;
  background: #EFF4F1;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.35;
}

.dish-detail-empty {
  margin-top: 4rpx;
  padding: 12rpx 14rpx;
  color: #8A958E;
  background: #F7F9F8;
  border-radius: 10rpx;
  font-size: 21rpx;
  line-height: 1.45;
}

.dish-card {
  box-shadow: 0 8rpx 22rpx rgba(38, 55, 44, 0.07);
}

.dish-cal {
  color: #315D3A;
}

.poster-preview-status,
.poster-preview-version {
  display: block;
}

.poster-preview-status {
  margin-top: 4rpx;
  color: #6B5E4C;
  font-size: 21rpx;
}

.poster-preview-version {
  margin-top: 3rpx;
  color: #849187;
  font-size: 19rpx;
}

/* 0.3.2：详情页信息层级收敛，保留分析、推荐与海报完整能力 */
.page-container {
  --color-bg-primary: var(--vm-bg, #EEF3F1);
  --color-bg-card: #FFFFFF;
  --color-accent-green: #27624F;
  --color-accent-green-light: #35755F;
  --color-accent-amber: #27624F;
  --color-text-primary: var(--vm-text, #1B2924);
  --color-text-secondary: var(--vm-text-secondary, #60716A);
  --color-text-muted: var(--vm-text-muted, #84938D);
  --color-border: var(--vm-line, #DDE6E2);
  --shadow-sm: 0 8rpx 24rpx rgba(21, 60, 50, 0.04);
  --shadow-md: 0 10rpx 30rpx rgba(21, 60, 50, 0.05);
  --shadow-lg: 0 18rpx 48rpx rgba(21, 60, 50, 0.09);
  background: var(--color-bg-primary);
}

.page-container {
  overflow: visible;
  background: var(--color-bg-primary);
}

.bg-decoration {
  display: none;
}

.loading-container {
  background: var(--color-bg-primary);
}

.steam {
  animation: none;
  opacity: 0.28;
}

.content {
  animation-duration: 240ms;
}

.photo-hero {
  height: 420rpx;
  border-radius: 0 0 30rpx 30rpx;
  background: #DCE6E1;
}

.hero-overlay {
  background: linear-gradient(180deg, rgba(21, 41, 34, 0.02) 30%, rgba(21, 41, 34, 0.76) 100%);
}

.meal-type-pill {
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  background: rgba(21, 60, 50, 0.72);
  backdrop-filter: none;
}

.no-image-icon {
  font-size: 0;
}

.no-image-icon::after {
  content: 'IMG';
  color: #27624F;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.main-content {
  padding: 20rpx 24rpx 48rpx;
}

.card,
.next-meal-card {
  margin-bottom: 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-md);
}

.card-header,
.card-header.green-theme,
.card-header.amber-theme,
.card-header.blue-theme,
.card-header.purple-theme,
.card-header.red-theme {
  padding: 23rpx 26rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: #FFFFFF;
}

.card-icon,
.label-emoji,
.fiber-icon,
.notes-icon,
.alert-icon {
  display: none;
}

.card-title {
  color: var(--color-text-primary);
  font-size: 29rpx;
  font-weight: 700;
}

.card-count,
.rating-pill,
.confidence-badge {
  border-radius: 10rpx;
  background: #E2ECE7 !important;
  color: #27624F !important;
}

.card-body {
  padding: 26rpx;
}

.nutrition-showcase {
  border-radius: 20rpx;
  background: #F4F8F6;
}

.calorie-number,
.score-number {
  color: #153C32 !important;
}

.macro-chip,
.macro-chip.protein,
.macro-chip.carbs,
.macro-chip.fat {
  border: 1rpx solid #E0E9E5;
  background: #FFFFFF;
}

.macro-chip.protein .chip-value,
.macro-chip.carbs .chip-value,
.macro-chip.fat .chip-value {
  color: #27624F;
}

.fiber-note,
.meal-brief,
.sodium-alert,
.zone-calc-note {
  border: 1rpx solid #DCE8E2;
  border-radius: 16rpx;
  background: #F0F6F3;
}

.food-item,
.analysis-item,
.action-item {
  border: 1rpx solid #E2E9E6;
  border-radius: 18rpx;
  background: #F8FAF9;
  box-shadow: none;
}

.analysis-rating,
.food-weight-tag {
  border-radius: 9rpx;
  background: #E2ECE7;
  color: #27624F;
}

.action-item.priority-high,
.action-item.priority-medium,
.action-item.priority-low {
  border-left-color: #8CAB9F;
}

.action-number,
.action-item.priority-high .action-number,
.action-item.priority-medium .action-number {
  background: #27624F;
}

.meal-plan-tabs {
  border: 1rpx solid #E2E9E6;
  background: #F2F6F4;
}

.meal-plan-tab.active {
  border-color: #BFD5CA;
  box-shadow: none;
}

.meal-card-header {
  background: #153C32;
}

.btn-primary,
.poster-btn.save,
.poster-btn.share,
.poster-btn.regenerate {
  border-radius: 18rpx;
  background: #27624F;
  box-shadow: none;
}

.btn-danger {
  border-radius: 18rpx;
  box-shadow: none;
}

.btn-primary,
.btn-danger,
.poster-btn,
.meal-plan-tab {
  transition: transform 160ms ease, opacity 160ms ease;
}

.btn-primary:active,
.btn-danger:active,
.poster-btn:active,
.meal-plan-tab:active {
  transform: scale(0.98);
  opacity: 0.86;
}

.anim-slide-up {
  animation-duration: 240ms;
}

.poster-overlay {
  background: rgba(21, 41, 34, 0.56);
  backdrop-filter: none;
}

.poster-container {
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: var(--shadow-lg);
}

@media (prefers-reduced-motion: reduce) {
  .anim-slide-up,
  .steam {
    animation: none;
  }
}

/* 0.3.10：营养评级改为稳定的内联徽标，避免文字背景随行高偏移。 */
.analysis-card .analysis-list {
  gap: 14rpx;
}

.analysis-card .analysis-item {
  position: relative;
  padding: 22rpx 22rpx 20rpx;
  overflow: hidden;
  border-color: #DFE8E4;
  background: #FBFCFB;
}

.analysis-card .analysis-item::before {
  content: '';
  position: absolute;
  top: 20rpx;
  bottom: 20rpx;
  left: 0;
  width: 5rpx;
  border-radius: 0 5rpx 5rpx 0;
  background: #9BB7AA;
}

.analysis-card .analysis-protein::before {
  background: #6E9F88;
}

.analysis-card .analysis-fat::before {
  background: #D39A4C;
}

.analysis-card .analysis-top {
  min-height: 46rpx;
  margin-bottom: 12rpx;
}

.analysis-card .analysis-rating {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  box-sizing: border-box;
  min-width: 82rpx;
  height: 42rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid #D7E4DD;
  border-radius: 21rpx;
  background: #EFF5F2;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  color: #416255;
  font-size: 21rpx;
  font-weight: 750;
  line-height: 42rpx;
  white-space: nowrap;
}

.analysis-card .analysis-rating .rating-dot {
  flex: 0 0 auto;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #799789;
}

.analysis-card .analysis-rating.rating-good {
  border-color: #CDE4D8;
  background: #EAF5EF;
  color: #27674E;
}

.analysis-card .analysis-rating.rating-good .rating-dot {
  background: #4C9A74;
}

.analysis-card .analysis-rating.rating-warning {
  border-color: #EED8B6;
  background: #FFF5E8;
  color: #9C621F;
}

.analysis-card .analysis-rating.rating-warning .rating-dot {
  background: #D29543;
}

.analysis-card .analysis-rating.rating-danger {
  border-color: #EDCDCA;
  background: #FCEFED;
  color: #A64B44;
}

.analysis-card .analysis-rating.rating-danger .rating-dot {
  background: #C7655C;
}

.analysis-card .analysis-rating.rating-info,
.analysis-card .analysis-rating.rating-neutral {
  border-color: #D7E3DE;
  background: #F0F4F2;
  color: #526C61;
}

.analysis-card .analysis-comment {
  display: block;
  color: #617169;
  line-height: 1.65;
}

/* 0.3.6：详情页层级、失效图片降级与未来餐单扫读优化 */
.photo-hero.is-placeholder {
  height: 270rpx;
  background:
    radial-gradient(circle at 18% 24%, rgba(255, 255, 255, 0.34) 0, rgba(255, 255, 255, 0) 30%),
    linear-gradient(135deg, #D9E9E0 0%, #C6DCD0 100%);
}

.photo-hero.is-placeholder .no-image {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  padding: 34rpx 32rpx 76rpx;
  background: transparent;
}

.no-image-mark {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: 1rpx solid rgba(39, 98, 79, 0.18);
  border-radius: 28rpx 14rpx 28rpx 14rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #27624F;
  font-size: 34rpx;
  font-weight: 800;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
}

.no-image-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.no-image-title {
  color: #173C31;
  font-size: 28rpx;
  font-weight: 750;
}

.photo-hero.is-placeholder .no-image-text {
  max-width: 430rpx;
  color: #60786D;
  font-size: 21rpx;
  line-height: 1.5;
}

.photo-hero.is-placeholder .hero-overlay {
  height: 94rpx;
  padding: 22rpx 28rpx;
  background: linear-gradient(180deg, rgba(22, 57, 46, 0) 0%, rgba(22, 57, 46, 0.58) 100%);
}

.main-content {
  padding-bottom: calc(46rpx + env(safe-area-inset-bottom));
}

.overview-card {
  border-color: #C9DCD2;
  box-shadow: 0 16rpx 40rpx rgba(21, 60, 50, 0.08);
}

.overview-card .card-header {
  justify-content: space-between;
}

.overview-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #E7F0EB;
  color: #27624F;
  font-size: 21rpx;
  font-weight: 700;
}

.overview-rating-score {
  padding-left: 8rpx;
  border-left: 1rpx solid #BFD2C8;
  color: #557066;
  font-weight: 600;
}

.overview-primary-row {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(150rpx, 0.7fr);
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.overview-primary-row .calorie-display,
.overview-score {
  display: flex;
  min-height: 132rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  margin: 0;
  padding: 20rpx;
  border: 1rpx solid #E0E9E5;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.84);
}

.overview-score {
  gap: 12rpx;
}

.overview-eyebrow {
  display: block;
  color: #7E8F88;
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.calorie-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 10rpx;
}

.overview-card .calorie-number {
  font-size: 50rpx;
  letter-spacing: -2rpx;
}

.overview-card .calorie-unit {
  display: inline;
  margin: 0;
  font-size: 20rpx;
}

.overview-score .score-number {
  font-size: 48rpx;
}

.overview-score .score-suffix {
  font-size: 18rpx;
}

.overview-card .macro-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.overview-card .macro-chip {
  min-width: 0;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
}

.detail-section-heading,
.recommend-section-intro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 34rpx 4rpx 16rpx;
}

.recommend-section-intro {
  align-items: flex-start;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 42rpx;
}

.detail-section-kicker,
.detail-section-title,
.detail-section-copy {
  display: block;
}

.detail-section-kicker {
  margin-bottom: 5rpx;
  color: #7E988C;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 2.5rpx;
}

.detail-section-title {
  color: #193229;
  font-size: 32rpx;
  font-weight: 760;
  letter-spacing: -0.5rpx;
}

.detail-section-meta {
  padding-bottom: 4rpx;
  color: #71837B;
  font-size: 21rpx;
}

.detail-section-copy {
  color: #6F8179;
  font-size: 21rpx;
  line-height: 1.55;
}

.foods-card .food-item,
.analysis-card .analysis-item,
.insights-card .insight-item {
  border-left-width: 0;
  background: #F8FAF9;
}

.foods-card .food-item + .food-item,
.analysis-card .analysis-item + .analysis-item {
  margin-top: 2rpx;
}

.recommend-card .summary-box {
  border: 1rpx solid #D6E4DD;
  border-left: 5rpx solid #568A70;
  background: #F2F7F4;
}

.recommend-card .summary-text {
  color: #284A3E;
  font-weight: 500;
}

.recommend-card .action-item {
  border-left-width: 0;
  background: #F8FAF9;
}

.meal-plan-tabs {
  position: sticky;
  top: 0;
  z-index: 3;
  border-color: #DCE7E1;
  box-shadow: 0 8rpx 20rpx rgba(21, 60, 50, 0.05);
}

.meal-plan-tab {
  min-height: 102rpx;
}

.meal-plan-tab.active {
  border-color: #B9D1C5;
  background: #FFFFFF;
  box-shadow: inset 0 -4rpx 0 #3C735E;
}

.next-meal-card {
  border-color: #D5E2DC;
  background: #FFFFFF;
  box-shadow: none;
}

.meal-card-header {
  padding: 24rpx;
  background: linear-gradient(135deg, #1E4B3C 0%, #2D6752 100%);
}

.meal-meta-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.meal-meta-line .meal-timing,
.meal-dish-count {
  margin: 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
}

.meal-dish-count {
  flex: 0 0 auto;
}

.meal-experience {
  margin: 0;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #E4ECE8;
  background: #F2F7F4;
}

.meal-experience-footer {
  margin-top: 6rpx;
  border-top: 1rpx solid #E4ECE8;
  border-bottom: 0;
}

.dishes-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 22rpx 24rpx;
}

.dish-card {
  margin: 0;
  padding: 20rpx;
  border: 1rpx solid #DEE8E3;
  border-radius: 18rpx;
  background: #FBFCFB;
  box-shadow: 0 8rpx 20rpx rgba(45, 78, 64, 0.045), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.dish-card:last-child {
  border-bottom: 1rpx solid #DEE8E3;
}

.dish-name-wrap {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 12rpx;
}

.dish-index {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 11rpx;
  background: #E4EEE9;
  color: #27624F;
  font-size: 18rpx;
  font-weight: 750;
}

.dish-name {
  line-height: 1.45;
}

.dish-cal {
  padding: 5rpx 9rpx;
  border-radius: 9rpx;
  background: #F0F5F2;
  white-space: nowrap;
}

.dish-facts {
  margin: 8rpx 0 0 46rpx;
}

.dish-fact {
  border: 1rpx solid #E1EAE6;
  background: #FAFBFA;
}

.dish-detail {
  margin: 14rpx 0 0 46rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #F7F9F8;
}

.recipe-detail-section {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.recipe-detail-section + .recipe-detail-section {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E3EBE7;
}

.recipe-detail-section .detail-label {
  width: auto;
  color: #496A5D;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.35;
}

.ingredient-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ingredient-tag {
  max-width: 100%;
  padding: 8rpx 13rpx;
  border: 1rpx solid #DCE8E2;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #52665E;
  font-size: 21rpx;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.cooking-steps {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cooking-step {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.cooking-step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
  border-radius: 50%;
  background: #E4EFE9;
  color: #35624F;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.cooking-step-text {
  min-width: 0;
  flex: 1;
  color: #52635C;
  font-size: 22rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.recipe-availability-note {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 8rpx 24rpx 22rpx;
  padding: 16rpx 18rpx;
  border: 1rpx dashed #CEDBD5;
  border-radius: 15rpx;
  background: #FAFBFA;
}

.recipe-note-label {
  flex: 0 0 auto;
  color: #496A5D;
  font-size: 21rpx;
  font-weight: 700;
}

.recipe-note-copy {
  color: #7A8983;
  font-size: 20rpx;
  line-height: 1.55;
}

.meal-reason {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 24rpx 24rpx;
  border-top: 1rpx solid #E1EAE6;
  background: #F5F8F6;
}

.reason-label {
  color: #315D4B;
  font-size: 21rpx;
  font-weight: 700;
}

.reason-text {
  color: #66776F;
  font-style: normal;
  line-height: 1.65;
}

.action-buttons {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 128rpx;
  gap: 12rpx;
  margin-top: 30rpx;
  padding: 14rpx;
  border: 1rpx solid #DCE6E1;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 14rpx 34rpx rgba(21, 60, 50, 0.08);
}

.action-buttons .btn-primary,
.action-buttons .btn-danger {
  width: 100%;
  min-height: 86rpx;
  margin: 0;
}

.action-buttons .btn-danger {
  border: 1rpx solid #E7CCCC;
  background: #FFF8F7;
  color: #A94C49;
}

.action-buttons .poster-error {
  grid-column: 1 / -1;
  grid-row: 2;
}

@media (prefers-reduced-motion: reduce) {
  .meal-plan-tab,
  .action-buttons .btn-primary,
  .action-buttons .btn-danger {
    transition: none;
  }
}
