<!-- pages/nutrition/nutrition.wxml -->
<!-- 设计概念：自然餐桌 Natural Table -->
<view class="page-container">
  <!-- 装饰背景元素 -->
  <view class="bg-decoration">
    <view class="bg-circle circle-1"></view>
    <view class="bg-circle circle-2"></view>
    <view class="bg-circle circle-3"></view>
  </view>

  <!-- 加载状态 -->
  <view hidden="{{!loading}}" class="loading-container">
    <view class="loading-bowl">
      <view class="bowl-body"></view>
      <view class="steam steam-1"></view>
      <view class="steam steam-2"></view>
      <view class="steam steam-3"></view>
    </view>
    <text class="loading-text">正在准备...</text>
  </view>

  <view hidden="{{loading}}" class="content">
    <!-- 页面标题区 -->
    <view class="page-header">
      <view class="header-main">
        <text class="page-title">饮食记录</text>
        <text class="page-subtitle">记录每一餐，关爱每一天</text>
      </view>
      <view class="header-date">
        <text class="date-day">{{currentDay}}</text>
        <text class="date-week">{{currentWeekday}}</text>
      </view>
    </view>

    <!-- 快捷上传区域 -->
    <view class="upload-card">
      <view class="upload-header">
        <text class="upload-title">记录这一餐</text>
        <text class="coverage-chip">近7天记录 {{recordedDays}} / {{expectedDays}} 天</text>
      </view>

      <!-- 餐次选择 - 胶囊式设计 -->
      <view class="meal-selector">
        <view class="meal-pill {{selectedMealType === 'breakfast' ? 'active' : ''}}"
              data-type="breakfast" bindtap="selectMealType">
          <text class="pill-icon">🌅</text>
          <text class="pill-text">早餐</text>
        </view>
        <view class="meal-pill {{selectedMealType === 'lunch' ? 'active' : ''}}"
              data-type="lunch" bindtap="selectMealType">
          <text class="pill-icon">☀️</text>
          <text class="pill-text">午餐</text>
        </view>
        <view class="meal-pill {{selectedMealType === 'dinner' ? 'active' : ''}}"
              data-type="dinner" bindtap="selectMealType">
          <text class="pill-icon">🌙</text>
          <text class="pill-text">晚餐</text>
        </view>
        <view class="meal-pill {{selectedMealType === 'snack' ? 'active' : ''}}"
              data-type="snack" bindtap="selectMealType">
          <text class="pill-icon">🍎</text>
          <text class="pill-text">加餐</text>
        </view>
      </view>

      <!-- 拍照按钮 -->
      <button class="capture-btn {{submittingPhoto ? 'is-busy' : ''}}" bindtap="takePhoto" disabled="{{submittingPhoto}}">
        <view class="btn-icon-wrap">
          <text class="btn-icon">📷</text>
        </view>
        <text class="btn-text">{{submittingPhoto ? '正在处理' : '拍照记录'}}</text>
        <view class="btn-arrow">→</view>
      </button>
      <view class="capture-helper">
        <view class="capture-helper-dot"></view>
        <text>识别完成后立即展示本餐结果，饮食建议随后补全</text>
      </view>
    </view>

    <!-- 今日营养概览 -->
    <view wx:if="{{todaySummary}}" class="summary-section">
      <view class="section-header">
        <view>
          <text class="section-title">今日营养</text>
          <text class="summary-scope">{{summaryLabel}}</text>
        </view>
        <view class="section-badge">
          <text class="badge-text">{{todaySummary.meals_count || 0}}餐</text>
        </view>
      </view>

      <!-- 营养环形图卡片 -->
      <view class="nutrition-overview">
        <!-- 热量中心 -->
        <view class="calorie-center">
          <view class="calorie-ring">
            <view class="ring-progress" style="--progress: {{calorieProgress}}deg;"></view>
            <view class="ring-inner">
              <text class="calorie-value">{{todaySummary.total_calories}}</text>
              <text class="calorie-unit">千卡</text>
            </view>
          </view>
          <text class="calorie-label">总热量</text>
          <text class="calorie-progress-copy">日参考 {{calorieProgressText}}</text>
        </view>

        <!-- 三大宏量元素 -->
        <view class="macro-grid">
          <view class="macro-item protein">
            <view class="macro-bar">
              <view class="bar-fill" style="height: {{proteinProgress}}%;"></view>
            </view>
            <view class="macro-info">
              <text class="macro-value">{{todaySummary.total_protein}}</text>
              <text class="macro-unit">g</text>
            </view>
            <text class="macro-label">蛋白质</text>
            <text class="macro-progress-copy">{{proteinProgressText}}</text>
          </view>
          <view class="macro-item carbs">
            <view class="macro-bar">
              <view class="bar-fill" style="height: {{carbsProgress}}%;"></view>
            </view>
            <view class="macro-info">
              <text class="macro-value">{{todaySummary.total_carbs}}</text>
              <text class="macro-unit">g</text>
            </view>
            <text class="macro-label">碳水</text>
            <text class="macro-progress-copy">{{carbsProgressText}}</text>
          </view>
          <view class="macro-item fat">
            <view class="macro-bar">
              <view class="bar-fill" style="height: {{fatProgress}}%;"></view>
            </view>
            <view class="macro-info">
              <text class="macro-value">{{todaySummary.total_fat}}</text>
              <text class="macro-unit">g</text>
            </view>
            <text class="macro-label">脂肪</text>
            <text class="macro-progress-copy">{{fatProgressText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 餐食记录列表 -->
    <view class="meals-section">
      <view class="section-header">
        <text class="section-title">最近记录</text>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{meals.length === 0}}" class="empty-state">
        <view class="empty-illustration">
          <text class="empty-plate">🍽️</text>
          <view class="empty-sparkle sparkle-1">✨</view>
          <view class="empty-sparkle sparkle-2">✨</view>
        </view>
        <text class="empty-title">还没有饮食记录</text>
        <text class="empty-hint">拍张照片开始记录今天的美食吧</text>
      </view>

      <!-- 餐食列表 -->
      <view wx:else class="meals-list">
        <view wx:for="{{meals}}" wx:key="id"
              class="meal-card anim-slide-up"
              style="animation-delay: {{index * 60}}ms;"
              data-meal-id="{{item.id}}" bindtap="viewMealDetail"
              hover-class="meal-card-pressed" hover-stay-time="80"
              role="button" aria-label="查看{{item.meal_type_label}}详情">

          <!-- 餐食图片 -->
          <view class="meal-image-wrap">
            <image wx:if="{{item.thumbnail_path}}" class="meal-image" src="{{item.thumbnail_path}}" mode="aspectFill" lazy-load="true" data-meal-id="{{item.id}}" binderror="onMealImageError" />
            <view wx:elif="{{item.image_unavailable}}" class="meal-image meal-image-placeholder image-unavailable">
              <text>历史图片不可用</text>
            </view>
            <view wx:else class="meal-image meal-image-placeholder">🍽️</view>
            <view class="meal-type-tag">{{item.meal_type_label}}</view>
          </view>

          <!-- 餐食信息 -->
          <view class="meal-content">
            <view class="meal-top-row">
              <text class="meal-time">{{item.meal_time_formatted}}</text>
            </view>

            <!-- 营养数据 -->
            <view class="meal-nutrition-row">
              <view class="nutrition-pill calories-pill">
                <text class="pill-value">{{item.total_calories}}</text>
                <text class="pill-unit">kcal</text>
              </view>
              <view class="nutrition-mini">
                <text class="mini-item">P {{item.total_protein}}g</text>
                <text class="mini-sep">·</text>
                <text class="mini-item">C {{item.total_carbs}}g</text>
                <text class="mini-sep">·</text>
                <text class="mini-item">F {{item.total_fat}}g</text>
              </view>
            </view>

            <!-- 评分 -->
            <view wx:if="{{item.overall_rating}}" class="meal-rating-row">
              <view class="rating-chip {{item.ratingColorClass}}">
                <text class="chip-label">{{item.overall_rating}}</text>
                <text wx:if="{{item.overall_score !== undefined && item.overall_score !== null}}" class="chip-score">{{item.overall_score}}分</text>
              </view>
            </view>
          </view>

          <!-- 箭头 -->
          <view class="meal-arrow">
            <text class="arrow-icon">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 图片选择、压缩和上传阶段；上传成功后立即关闭 -->
  <view wx:if="{{submittingPhoto}}" class="analyzing-overlay">
    <view class="analyzing-modal">
      <view class="analyzing-animation">
        <view class="scan-ring"></view>
        <text class="scan-icon">🔍</text>
      </view>
      <text class="analyzing-title">{{uploadStatusText}}</text>
      <text class="analyzing-subtitle">识图完成后会立即展示本餐核心分析</text>
      <view class="progress-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
  </view>
</view>
