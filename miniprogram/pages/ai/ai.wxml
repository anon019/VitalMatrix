<!--pages/ai/ai.wxml-->
<view class="ai-container">
  <!-- AI 概览 -->
  <view class="hero-section">
    <view class="hero-grid" aria-hidden="true"></view>
    <view class="ai-core">
      <view class="core-center">
        <text class="core-icon">AI</text>
      </view>
    </view>

    <view class="hero-text">
      <text class="hero-kicker">DAILY GUIDANCE</text>
      <text class="hero-title">AI 健康助理</text>
      <text class="hero-subtitle">{{todayDate}}</text>
    </view>

    <view class="model-badge" wx:if="{{generatedTime}}">
      <text class="badge-text">今日建议</text>
      <text class="badge-time">{{generatedTime}}</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-pulse">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>
    <text class="loading-text">AI 正在分析您的健康数据...</text>
  </view>

  <!-- 内容区域 -->
  <view class="content-area" wx:else>
    <!-- 数据日期提示 -->
    <view class="date-notice glass-card" wx:if="{{isStale}}">
      <view class="notice-icon-wrap">
        <text class="notice-icon">DATE</text>
      </view>
      <text class="notice-text">最近建议 · 来源 {{dataDate}}，没有冒充今日生成</text>
    </view>

    <view class="glass-card completeness-card" wx:if="{{dataCompleteness.length}}">
      <view class="completeness-head">
        <text class="completeness-title">本次数据完整度</text>
        <text class="completeness-caption">建议依据</text>
      </view>
      <view class="completeness-list">
        <view class="completeness-item {{item.available ? 'available' : ''}}" wx:for="{{dataCompleteness}}" wx:key="label">
          <text>{{item.label}}</text><text>{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="empty-state glass-card" wx:if="{{loadError}}">
      <text class="empty-icon">!</text>
      <text class="empty-title">AI 建议暂时没加载出来</text>
      <text class="empty-desc">{{loadError}}</text>
      <view class="refresh-btn" bindtap="retryLoad">
        <text class="btn-text">重新加载</text>
        <view class="btn-shine"></view>
      </view>
    </view>

    <!-- 一句话总结 - 突出显示 -->
    <view class="summary-hero glass-card card-animate" wx:if="{{summary}}" style="--delay: 0.1s">
      <view class="summary-icon-wrap">
        <text class="summary-icon">✦</text>
      </view>
      <text class="summary-text">{{summary}}</text>
    </view>

    <!-- 饮食、恢复、活动建议：沿用线上卡片视觉 -->
    <view
      class="insight-card glass-card advice-theme card-animate"
      wx:for="{{recommendationSections}}"
      wx:for-item="section"
      wx:key="key"
      style="--delay: {{0.15 + index * 0.08}}s"
    >
      <view class="card-header">
        <view class="card-icon-wrap advice-icon">
          <text class="card-emoji">{{section.key === 'nutrition' ? '🥗' : section.key === 'recovery' ? '🌙' : '🏃'}}</text>
        </view>
        <view class="card-title-group">
          <text class="card-title">{{section.title}}</text>
          <text class="card-subtitle">{{section.subtitle}}</text>
        </view>
      </view>
      <view class="card-content">
        <view class="advice-item" wx:for="{{section.items}}" wx:for-item="advice" wx:key="index">
          <view class="advice-number">{{index + 1}}</view>
          <view class="advice-body">
            <text class="advice-label" wx:if="{{advice.label}}">{{advice.label}}</text>
            <text class="advice-text">{{advice.text}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 健康知识点 -->
    <view class="insight-card glass-card knowledge-theme card-animate" wx:if="{{knowledgeSections.length}}" style="--delay: 0.42s">
      <view class="card-header">
        <view class="card-icon-wrap knowledge-icon"><text class="card-emoji">🧠</text></view>
        <view class="card-title-group">
          <text class="card-title">健康知识点</text>
          <text class="card-subtitle">Health Education</text>
        </view>
      </view>
      <view class="card-content">
        <view class="knowledge-section" wx:for="{{knowledgeSections}}" wx:for-item="section" wx:key="index">
          <view class="section-header"><view class="section-dot"></view><text class="section-title">{{section.title}}</text></view>
          <view class="knowledge-list">
            <view class="knowledge-item" wx:for="{{section.items}}" wx:for-item="point" wx:key="index">
              <text class="knowledge-label" wx:if="{{point.label}}">{{point.label}}</text>
              <text class="knowledge-text">{{point.text}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state glass-card" wx:if="{{!loadError && !recommendationSections.length && !knowledgeSections.length}}">
      <view class="empty-mark"><text>AI</text></view>
      <text class="empty-title">暂无AI建议</text>
      <text class="empty-desc">后端AI服务准备中...</text>
      <view class="refresh-btn" bindtap="loadData">
        <text class="btn-text">刷新</text>
        <view class="btn-shine"></view>
      </view>
    </view>

    <view class="refresh-btn {{regenerating ? 'is-busy' : ''}}" bindtap="regenerate" aria-disabled="{{regenerating}}">
      <text class="btn-text">{{regenerating ? '正在重新生成…' : '重新生成今日建议'}}</text>
      <view class="btn-shine"></view>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-spacer"></view>
  </view>
</view>
