  align-items: center;
  gap: 18rpx;
  padding: 36rpx 28rpx 32rpx;
  background: #153C32;
}

.ai-core {
  width: 72rpx;
  height: 72rpx;
  margin: 0;
}

.core-center {
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.09);
  box-shadow: none;
}

.core-icon {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-text {
