/* pages/settings/settings.wxss */

/* 页面头部 */
.page-header {
  padding: 40rpx 20rpx 20rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #2E7D32;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #666666;
}

/* ========== 用户资料 ========== */
.profile-card { border-top: 6rpx solid #2E7D32; }
.profile-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 24rpx; }
.profile-title { display: block; margin-bottom: 6rpx; }
.profile-caption { display: block; color: #777; font-size: 23rpx; }
.profile-edit { margin: 0; padding: 8rpx 20rpx; color: #2E7D32; background: #E8F5E9; border-radius: 999rpx; font-size: 23rpx; line-height: 1.5; }
.profile-edit::after { border: 0; }
.profile-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.profile-value { padding: 20rpx 12rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; background: #F6F8F6; border-radius: 12rpx; font-size: 27rpx; font-weight: 600; }
.profile-label { color: #777; font-size: 22rpx; font-weight: 400; }
.profile-form { border-top: 1rpx solid #E5E9E6; }
.form-row { min-height: 86rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid #E5E9E6; font-size: 27rpx; }
.form-value { color: #2E7D32; }
.weight-input-wrap { display: flex; align-items: center; gap: 8rpx; color: #777; }
.weight-input { width: 150rpx; text-align: right; color: #2E7D32; }
.profile-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.profile-cancel,
.profile-save { flex: 1; border-radius: 12rpx; font-size: 25rpx; }
.profile-cancel::after,
.profile-save::after { border: 0; }
.profile-cancel { color: #555; background: #F1F3F1; }
.profile-save { color: #FFF; background: #2E7D32; }

/* ========== 降脂目标卡片 ========== */
.goal-card {
  background: linear-gradient(135deg, #E8F5E9 0%, #FFFFFF 50%, #FFF8E1 100%);
}

.card-header {
  margin-bottom: 20rpx;
}

.goal-highlight {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.1);
  margin-bottom: 24rpx;
}

.goal-main {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #2E7D32;
  margin-bottom: 16rpx;
}

.goal-method {
  display: block;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.training-plan-section {
  margin-bottom: 24rpx;
}

.section-subtitle {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.plan-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.plan-item {
  display: flex;
  align-items: flex-start;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.plan-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.plan-content {
  flex: 1;
}

.plan-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.plan-value {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #2E7D32;
  margin-bottom: 8rpx;
}

.plan-unit {
  font-size: 32rpx;
  color: #999999;
  font-weight: 400;
}

.plan-desc {
  display: block;
  line-height: 1.5;
}

.goal-tips {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background-color: #E3F2FD;
  border-radius: 8rpx;
  gap: 12rpx;
}

.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  line-height: 1.6;
  color: #333333;
}

/* ========== 个人数据网格 ========== */
.personal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.personal-item {
  background-color: #F5F5F5;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.personal-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.personal-label {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.personal-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 4rpx;
}

.personal-unit {
  font-size: 22rpx;
  color: #999999;
}

/* ========== 心率区间卡片 ========== */
.zone-boundaries-card {
  background: linear-gradient(135deg, #E3F2FD 0%, #FFFFFF 100%);
}

.zone-boundaries-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.zone-boundary-item {
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.zone-boundary-item.zone-highlight {
  border: 2rpx solid #2E7D32;
  box-shadow: 0 4rpx 12rpx rgba(46, 125, 50, 0.2);
}

.zone1-bg {
  background: linear-gradient(135deg, #E3F2FD 0%, #FFFFFF 100%);
}

.zone2-bg {
  background: linear-gradient(135deg, #E8F5E9 0%, #FFFFFF 100%);
}

.zone3-bg {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFFFFF 100%);
}

.zone4-bg {
  background: linear-gradient(135deg, #FFEBEE 0%, #FFFFFF 100%);
}

.zone5-bg {
  background: linear-gradient(135deg, #F3E5F5 0%, #FFFFFF 100%);
}

.zone-boundary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.zone-boundary-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.zone-boundary-percent {
  color: #999999;
}

.zone-boundary-range {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2E7D32;
  margin-bottom: 8rpx;
}

.zone-boundary-desc {
  display: block;
  color: #666666;
  line-height: 1.5;
}

.zone-calc-note {
  padding: 16rpx;
  background-color: #FFF8E1;
  border-radius: 8rpx;
}

/* 信息项 */
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  text-align: right;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 授权状态 */
.auth-status {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.status-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.status-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.status-subtitle {
  font-size: 24rpx;
  color: #999999;
}

/* 设置提示 */
.setting-tip {
  padding: 20rpx;
  background-color: #FFF3E0;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.setting-tip text {
  color: #F57C00;
  line-height: 1.6;
}

/* 0.3.2：设置页改为清晰的资料与设备控制台 */
.container {
  min-height: 100vh;
  padding: 0 24rpx 48rpx;
  background: var(--vm-bg, #EEF3F1);
}

.page-header {
  margin: 0 -24rpx 18rpx;
  padding: 40rpx 32rpx 34rpx;
  background: #153C32;
}

.page-title {
  margin-bottom: 6rpx;
  color: #FFFFFF;
  font-size: 42rpx;
}

.page-subtitle {
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.loading {
  padding-top: 12rpx;
}

.settings-skeleton {
  border-radius: 18rpx;
  background: #DFE8E4;
  animation: settingsSkeleton 1.2s ease-in-out infinite alternate;
}

.skeleton-heading {
  width: 38%;
  height: 32rpx;
  margin: 18rpx 0;
}

.skeleton-card {
  height: 250rpx;
  margin-bottom: 18rpx;
}

.skeleton-card.short {
  height: 170rpx;
}

@keyframes settingsSkeleton {
  from { opacity: 0.5; }
  to { opacity: 0.9; }
}

.card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border: 1rpx solid var(--vm-line, #DDE6E2);
  border-radius: 26rpx;
  background: var(--vm-surface, #FFFFFF);
  box-shadow: 0 10rpx 30rpx rgba(21, 60, 50, 0.05);
}

.profile-card {
  border-top: 1rpx solid var(--vm-line, #DDE6E2);
}

.card-title {
  color: var(--vm-text, #1B2924);
  font-size: 30rpx;
  font-weight: 700;
}

.profile-caption {
  color: var(--vm-text-muted, #84938D);
}

.profile-edit {
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  background: var(--vm-brand-soft, #E2F0E8);
  color: #27624F;
}

.profile-summary {
  gap: 10rpx;
}

.profile-value {
  padding: 18rpx 8rpx;
  border: 1rpx solid #E7EEEA;
  border-radius: 16rpx;
  background: #F7F9F8;
}

.goal-card,
.zone-boundaries-card {
  background: #FFFFFF;
}

.goal-highlight {
  margin-bottom: 22rpx;
  padding: 0 0 22rpx;
  border-bottom: 1rpx solid var(--vm-line, #DDE6E2);
  border-radius: 0;
  box-shadow: none;
  text-align: left;
}

.goal-main {
  margin-bottom: 8rpx;
  color: #153C32;
  font-size: 36rpx;
}

.goal-method {
  color: var(--vm-text-secondary, #60716A);
  font-size: 24rpx;
}

.plan-box {
  gap: 10rpx;
}

.plan-item {
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid #E7EEEA;
  border-radius: 16rpx;
  background: #F7F9F8;
  box-shadow: none;
}

.plan-icon,
.personal-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #27624F;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.plan-icon {
  width: 62rpx;
  height: 48rpx;
  margin-right: 18rpx;
  border-radius: 12rpx;
  background: #E2ECE7;
}

.plan-value {
  display: inline;
  margin-right: 10rpx;
  color: #153C32;
  font-size: 38rpx;
}

.goal-tips,
.zone-calc-note {
  border-radius: 14rpx;
  background: #F0F5F2;
}

.tip-icon {
  color: #27624F;
  font-size: 18rpx;
  font-weight: 800;
}

.personal-item {
  padding: 22rpx;
  border: 1rpx solid #E7EEEA;
  border-radius: 16rpx;
  background: #F7F9F8;
}

.personal-icon {
  height: 28rpx;
  margin-bottom: 8rpx;
}

.personal-value {
  color: #153C32;
  font-size: 42rpx;
}

.status-icon {
  min-width: 58rpx;
  margin-right: 18rpx;
  padding: 7rpx 8rpx;
  border-radius: 10rpx;
  font-size: 18rpx;
  font-weight: 800;
  text-align: center;
}

.status-ok {
  background: #E2F0E8;
  color: #27624F;
}

.status-off {
  background: #F1F3F2;
  color: #7B8983;
}

.zone-boundaries-list {
  gap: 0;
  margin-top: 16rpx;
}

.zone-boundary-item,
.zone1-bg,
.zone2-bg,
.zone3-bg,
.zone4-bg,
.zone5-bg {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--vm-line, #DDE6E2);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.zone-boundary-item.zone-highlight {
  margin: 4rpx -12rpx;
  padding: 20rpx 12rpx;
  border: 1rpx solid #BFD5CA;
  border-radius: 16rpx;
  background: #F0F6F3;
  box-shadow: none;
}

.zone-boundary-name {
  color: var(--vm-text, #1B2924);
}

.zone-boundary-range {
  color: #27624F;
  font-size: 32rpx;
}

.btn-primary,
.btn-secondary,
.profile-cancel,
.profile-save {
  transition: transform 160ms ease, opacity 160ms ease;
}

.btn-primary:active,
.btn-secondary:active,
.profile-cancel:active,
.profile-save:active {
  transform: scale(0.98);
  opacity: 0.86;
}

@media (prefers-reduced-motion: reduce) {
  .settings-skeleton {
    animation: none;
  }
}

/* 0.3.6：设置页操作语义、可点击性和技术信息收敛 */
.page-header {
  padding: 34rpx 8rpx 22rpx;
}

.page-title {
  color: #193229;
  font-size: 42rpx;
}

.page-subtitle {
  color: #7B8C84;
  font-size: 24rpx;
}

.card-caption {
  display: block;
  margin-top: 7rpx;
  color: #84938D;
  font-size: 21rpx;
  line-height: 1.5;
}

.management-card {
  padding-bottom: 10rpx;
}

.management-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E7EEEA;
  transition: transform 150ms ease, opacity 150ms ease;
}

.management-action:last-child {
  border-bottom: 0;
}

.management-action-title,
.management-action-copy {
  display: block;
}

.management-action-title {
  color: #283C34;
  font-size: 26rpx;
  font-weight: 650;
}

.management-action-copy {
  margin-top: 5rpx;
  color: #84938D;
  font-size: 20rpx;
  line-height: 1.45;
}

.management-arrow {
  flex: 0 0 auto;
  color: #8B9892;
  font-size: 36rpx;
}

.settings-action-pressed {
  transform: scale(0.985);
  opacity: 0.82;
}

.service-status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: #27624F;
  font-weight: 650;
}

.service-status::before {
  content: '';
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #4C9A74;
}

.btn-secondary,
.btn-primary,
.profile-edit {
  min-height: 72rpx;
}

.profile-edit {
  min-height: 0;
}

/* 0.3.10：修复深色头部对比度，并让健康目标成为真实可编辑设置。 */
.page-header {
  position: relative;
  margin: 0 -24rpx 20rpx;
  padding: 40rpx 32rpx 34rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #0F372D 0%, #1B5944 100%);
  box-shadow: 0 14rpx 32rpx rgba(15, 55, 45, 0.15);
}

.page-header::after {
  content: '';
  position: absolute;
  right: -54rpx;
  bottom: -104rpx;
  width: 220rpx;
  height: 220rpx;
  border: 1rpx solid rgba(227, 247, 237, 0.15);
  border-radius: 50%;
  box-shadow: 0 0 0 34rpx rgba(227, 247, 237, 0.035);
  pointer-events: none;
}

.page-title,
.page-subtitle {
  position: relative;
  z-index: 1;
}

.page-title {
  color: #FFFFFF;
  font-size: 43rpx;
  font-weight: 760;
  letter-spacing: -0.5rpx;
}

.page-subtitle {
  color: rgba(235, 248, 241, 0.72);
}

.card {
  border-color: #D9E4DF;
  box-shadow: 0 11rpx 30rpx rgba(20, 61, 48, 0.06);
}

.goal-card {
  border-color: #CADFD4;
  background: linear-gradient(155deg, #FFFFFF 0%, #F8FBF9 100%);
}

.goal-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.goal-sync-note {
  display: block;
  margin-top: 7rpx;
  color: #648074;
  font-size: 20rpx;
  line-height: 1.45;
}

.goal-highlight {
  position: relative;
  margin: 0 0 24rpx;
  padding: 24rpx 24rpx 24rpx 28rpx;
  overflow: hidden;
  border: 1rpx solid #D3E4DB;
  border-radius: 18rpx;
  background: #F1F7F4;
}

.goal-highlight::before {
  content: '';
  position: absolute;
  top: 22rpx;
  bottom: 22rpx;
  left: 0;
  width: 5rpx;
  border-radius: 0 5rpx 5rpx 0;
  background: #4C8D70;
}

.goal-main {
  color: #174735;
  font-size: 34rpx;
  line-height: 1.4;
}

.goal-method {
  color: #5B7168;
  line-height: 1.6;
}

.goal-form {
  margin-bottom: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #D7E4DE;
  border-radius: 18rpx;
  background: #F7FAF8;
}

.goal-field-label {
  display: block;
  margin: 4rpx 0 10rpx;
  color: #345A4B;
  font-size: 22rpx;
  font-weight: 700;
}

.goal-textarea {
  box-sizing: border-box;
  width: 100%;
  height: 112rpx;
  min-height: 112rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #D5E1DB;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #243D33;
  font-size: 25rpx;
  line-height: 1.6;
}

.goal-actions {
  margin-top: 6rpx;
}

.plan-item {
  transition: transform 150ms ease, border-color 150ms ease;
}

.btn-secondary,
.btn-primary,
.profile-edit,
.profile-cancel,
.profile-save {
  border-radius: 14rpx;
}

@media (prefers-reduced-motion: reduce) {
  .plan-item {
    transition: none;
  }
}
